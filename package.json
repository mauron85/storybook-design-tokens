{
	"name": "storybook-design-tokens-panel",
	"version": "0.1.4",
	"description": "Storybook v10 addon panel for semantic and primitive design tokens",
	"type": "module",
	"license": "MIT",
	"author": "Marián Hello",
	"keywords": [
		"storybook",
		"storybook-addon",
		"design-tokens",
		"design-system",
		"css-variables",
		"style-dictionary",
		"theme"
	],
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"default": "./dist/index.js"
		},
		"./preview": {
			"types": "./dist/preview.d.ts",
			"default": "./dist/preview.js"
		},
		"./preset": "./dist/preset.js",
		"./manager": "./dist/manager.js",
		"./manager-helpers": "./dist/manager-helpers.js",
		"./package.json": "./package.json"
	},
	"scripts": {
		"prebuild": "node -e \"fs.rmSync('.tmp/dist', { recursive: true, force: true })\"",
		"build": "tsup --out-dir .tmp/dist",
		"build-storybook": "NODE_PRESERVE_SYMLINKS=1 NODE_OPTIONS='--loader ./scripts/ramdisk-loader.mjs' storybook build --output-dir .tmp/storybook-static",
		"build:watch": "npm run build -- --watch",
		"eject-ts": "zx scripts/eject-typescript.js",
		"postinstall": "node scripts/welcome.js",
		"format": "prettier --write .",
		"lint": "eslint --cache .",
		"lint:fix": "pnpm lint --fix",
		"prerelease": "zx scripts/prepublish-checks.js",
		"release": "npm run build && auto shipit",
		"start": "run-p build:watch \"storybook --no-open --quiet\"",
		"storybook": "NODE_PRESERVE_SYMLINKS=1 NODE_OPTIONS='--loader ./scripts/ramdisk-loader.mjs' storybook dev -p 6006",
		"test": "echo \"Error: no test specified\" && exit 1"
	},
	"files": [
		"dist",
		"README.md",
		"LICENSE"
	],
	"peerDependencies": {
		"lightningcss": "*",
		"postcss": "^8.5.6",
		"postcss-nested": "^7.0.2",
		"react": ">=18",
		"react-aria-components": "^1.15.1",
		"react-dom": ">=18",
		"storybook": "*"
	},
	"devDependencies": {
		"@eslint/js": "^9.36.0",
		"@storybook/addon-docs": "next",
		"@storybook/icons": "^2.0.0",
		"@storybook/react-vite": "next",
		"@types/node": "^24.0.0",
		"@types/react": "^19",
		"@types/react-dom": "^19",
		"@vitejs/plugin-react": "^4.7.0",
		"auto": "^11.3.0",
		"boxen": "^8.0.1",
		"eslint": "^9.36.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-prettier": "^5.5.4",
		"eslint-plugin-react": "^7.37.5",
		"eslint-plugin-storybook": "next",
		"npm-run-all2": "^8.0.4",
		"path": "^0.12.7",
		"postcss": "^8.5.6",
		"postcss-nested": "*",
		"prettier": "^3.6.2",
		"prompts": "^2.4.2",
		"react": "^19",
		"react-aria-components": "^1.15.1",
		"react-dom": "^19",
		"semver": "^7.7.4",
		"storybook": "10.3.0-alpha.12",
		"ts-dedent": "^2.2.0",
		"tsup": "^8.5.0",
		"typescript": "^5.8.3",
		"typescript-eslint": "^8.44.1",
		"vite": "^7.0.5",
		"zx": "^8.7.1"
	},
	"bundler": {
		"managerEntries": [
			"src/manager.tsx",
			"src/manager-helpers.tsx"
		],
		"previewEntries": [
			"src/preview.ts",
			"src/index.ts"
		],
		"nodeEntries": [
			"src/constants.ts",
			"src/preset.ts",
			"src/cssModuleTracker/serializables.ts",
			"src/cssModuleTracker/core.ts",
			"src/cssModuleTracker/plugin.ts"
		]
	},
	"storybook": {
		"displayName": "Design Tokens panel",
		"supportedFrameworks": [
			"supported-frameworks"
		],
		"icon": "https://user-images.githubusercontent.com/321738/63501763-88dbf600-c4cc-11e9-96cd-94adadc2fd72.png"
	},
	"volta": {
		"node": "24.11.0"
	}
}
